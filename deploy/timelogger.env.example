# Copy to C:\ProgramData\Timelogger\timelogger.env and edit. One KEY=VALUE per line.
# Everything is optional; these are the defaults.

PORT=3000
# 127.0.0.1 = only this machine (use with the Caddy/IIS proxy in front). 0.0.0.0 = reachable directly.
HOSTNAME=127.0.0.1

# The app is served over HTTPS, so mark the session cookie Secure. Leave it out if you use plain http.
COOKIE_SECURE=1

# If damavandscm uses a certificate from your company CA that this VPS does not already trust,
# put the CA certificate (PEM format) on the VPS and point to it here.
# NODE_EXTRA_CA_CERTS=C:\ProgramData\Timelogger\company-ca.pem

# DB_PATH=C:\ProgramData\Timelogger\data\timelogger.db
# ADO_BASE=https://damavandscm/tfs
# ADO_COLLECTION=Sepidar
# LOG_API_BASE=https://damavandscm:8081/api
# AD_DOMAIN=SYSTEMGROUP
